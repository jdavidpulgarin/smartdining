# Backend REST (login y carga inicial de comandas)
VITE_API_URL=http://localhost:4000/api

# socket-server (tiempo real: order:created / order:status)
VITE_SOCKET_URL=http://localhost:4001

# El KDS NO lleva secretos: se autentica con el JWT del usuario de cocina que
# devuelve POST /api/auth/login. La INTERNAL_API_KEY es solo servidor-a-servidor
# y NUNCA debe aparecer en una variable VITE_ (todo lo VITE_ viaja al navegador).
