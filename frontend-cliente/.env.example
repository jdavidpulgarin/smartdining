# Copia este archivo a .env para tu configuracion local (no subas .env al repositorio)

# En desarrollo no hace falta definirlas: se usa el host desde el que se abre la página con los puertos 4000 (API) y 4001 (socket). Descoméntalas solo para apuntar a otro servidor.
# VITE_API_URL=http://localhost:4000/api
# VITE_SOCKET_URL=http://localhost:4001

# Modo simulado de sesion QR (solo funciona en desarrollo con npm run dev)
VITE_MODO_SIMULADO=false
