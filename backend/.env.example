# Servidor
PORT=4000
NODE_ENV=development

# Seguridad del transporte y acceso (Fase 2 - H-04, H-10, H-27)
# CORS_ORIGINS: Lista de orígenes permitidos separados por comas (con protocolo http:// o https:// y sin barra final).
# En desarrollo y pruebas es opcional: por defecto permite http://localhost:5173, http://localhost:5174, http://localhost:5175.
# En producción (NODE_ENV=production) es OBLIGATORIA: si falta o está vacía, no se permite ningún origen cruzado.
# Ejemplo en producción:
# CORS_ORIGINS=https://app.example.com,https://staff.example.com,https://cocina.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# TRUST_PROXY: Confianza en cabeceras X-Forwarded-For y X-Forwarded-Proto para Express detrás de proxy inverso (Nginx / Docker).
# Necesario para que el rate limit de login (H-04) y sesión QR (H-27) obtenga la IP real del cliente y no la del proxy.
# Acepta: 'true' o '1' (confía en el primer salto), un número entero de saltos, o IP/rango específico (ej: 172.31.250.10).
# En desarrollo: dejar vacío (apagado, para no permitir falsificación de IP en peticiones directas).
# En producción (VPS con docker-compose.prod.yml): 172.31.250.10 (IP fija de nginx) o 1.
TRUST_PROXY=

# PostgreSQL (usa las credenciales de tu instancia local, cargada con database/schema.sql y seed.sql de Jarrison)
PGHOST=localhost
PGPORT=5432
PGDATABASE=smartdining
PGUSER=postgres
PGPASSWORD=postgres

# Redis (cache de sesiones activas — coordina el prefijo de llaves con Roberto)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
# Vigencia de la sesion del comensal emitida al escanear el QR de la mesa
JWT_COMENSAL_EXPIRES_IN=3h

# socket-server de Roberto (tiempo real). El backend le avisa de los pedidos por
# HTTP interno; si no responde, el pedido se crea igual (ver src/services/socket.notifier.js).
SOCKET_URL=http://localhost:4001
# Clave compartida que viaja en la cabecera x-internal-key hacia /internal/*.
# Debe ser LA MISMA que INTERNAL_API_KEY de socket-server/.env
# (genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
INTERNAL_API_KEY=cambia-esto-por-una-clave-interna-larga
# Milisegundos que el backend espera al socket-server antes de rendirse
SOCKET_TIMEOUT_MS=1500

# Base de la PWA del comensal: con ella se arma la url del QR de la mesa
# (POST /api/mesas/:id/abrir devuelve <FRONTEND_CLIENTE_URL>/?token=<token>)
FRONTEND_CLIENTE_URL=http://localhost:5173
