# Servidor (el backend REST usa 4000, por eso el socket-server va en 4001)
PORT=4001
NODE_ENV=development

# Orígenes permitidos por CORS, separados por comas y SIN comodín "*".
# Por defecto: puertos de Vite de frontend-cliente, frontend-restaurante y frontend-kds.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# SECRETOS OBLIGATORIOS: el servidor NO arranca si falta alguno, si mide menos de
# 32 caracteres, si conserva el valor "cambia-esto-..." o si dos son iguales.
# Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Debe ser el MISMO secreto que usa backend/ para firmar los JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Clave que el backend envía en la cabecera x-internal-key al llamar a /internal/*
# (la MISMA de backend/.env). Solo servidor a servidor: nunca en un frontend ni con VITE_.
INTERNAL_API_KEY=cambia-esto-por-una-clave-interna-larga

# Firma de los tokens QR (distinta de JWT_SECRET y de INTERNAL_API_KEY).
QR_SECRET=cambia-esto-por-otro-secreto-largo
# Pagos con Wompi (sandbox). Todo o nada: sin ninguna WOMPI_* los pagos quedan apagados;
# con alguna, deben estar TODAS y el servidor valida su formato al arrancar.
# Se obtienen en comercios.wompi.co → Desarrolladores (llaves de prueba). Requiere BACKEND_URL.
# Solo la llave PÚBLICA llega al cliente (dentro de la respuesta de POST /pagos/intencion).
# WOMPI_PUBLIC_KEY=pub_test_cambia-esto
# WOMPI_PRIVATE_KEY=prv_test_cambia-esto
# WOMPI_INTEGRITY_SECRET=test_integrity_cambia-esto
# WOMPI_EVENTS_SECRET=test_events_cambia-esto
# WOMPI_API_URL=https://sandbox.wompi.co/v1
# Minutos de vida de una intención de pago (5-120)
PAGOS_TTL_MINUTOS=30

# Antigüedad máxima (s) de un evento de Wompi. 25 h por defecto: Wompi reintenta hasta 24 h después.
# PAGOS_WEBHOOK_TOLERANCIA_SEG=90000

# Web Push: genera las llaves con "npm run vapid" (una vez por entorno)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Redis: carritos, idempotencia, revocaciones de QR y suscripciones push.
# Opcional en desarrollo (sin ella el estado vive en memoria y se pierde al
# reiniciar). OBLIGATORIA con NODE_ENV=production: el servidor no arranca sin ella.
REDIS_URL=redis://localhost:6379

# Backend (servidor a servidor, con INTERNAL_API_KEY). Opcional en desarrollo:
# sin ella la rotación automática del QR queda apagada.
BACKEND_URL=http://localhost:4000
# Cada cuántos minutos rota el QR de una mesa abierta mientras no haya comensales (1-60)
ROTACION_QR_MINUTOS=3

# Proxy de confianza (producción, detrás de Nginx): IPs o rangos CIDR separados
# por comas. Solo a las conexiones que vienen de ahí se les cree X-Real-IP; vacío
# = se usa la IP de la conexión. En docker-compose.prod.yml es la IP fija de nginx.
TRUST_PROXY=

# Capacidad que se asume si el backend no informa la de una mesa. Conexiones de
# comensal por mesa = capacidad + 4.
MESA_CAPACIDAD_POR_DEFECTO=6

# Vigencia por defecto del QR de mesa, en minutos (reutilizable durante ese lapso)
QR_TTL_MINUTOS=360

# Vigencia del JWT de la pantalla/tablet de mesa (modelo "QR en vidrio"): la
# tablet queda montada de sesión en sesión, por eso es larga (formato de "ms"/jsonwebtoken, ej. 30d)
PANTALLA_TOKEN_EXPIRES_IN=30d
