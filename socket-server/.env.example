# Servidor (el backend REST usa 4000, por eso el socket-server va en 4001)
PORT=4001
NODE_ENV=development

# Orígenes permitidos por CORS, separados por comas y SIN comodín "*".
# Por defecto: puertos de Vite de frontend-cliente, frontend-restaurante y frontend-kds.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Debe ser el MISMO secreto que usa backend/ para firmar los JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Clave que el backend envía en la cabecera x-internal-key al llamar a /internal/*
# (genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
INTERNAL_API_KEY=cambia-esto-por-una-clave-interna-larga
