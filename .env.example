# ==============================================================================
# SmartDining — variables del docker-compose.yml de DESARROLLO (raíz del repo)
# Copia este archivo a .env (está en .gitignore). Todo es opcional en local.
# ==============================================================================

POSTGRES_DB=smartdining
POSTGRES_USER=postgres
# Solo desarrollo. Debe coincidir con PGPASSWORD de backend/.env.
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

# ==============================================================================
# Valores que deben ser IDÉNTICOS en backend/.env y socket-server/.env
# (no van en este archivo; se listan aquí para que nadie los olvide):
#
#   JWT_SECRET        el backend firma los JWT y el socket-server los verifica
#   INTERNAL_API_KEY  el backend la envía en x-internal-key a /internal/*
#
# Y deben ser DISTINTOS entre sí y de QR_SECRET (solo socket-server/.env).
# El socket-server no arranca si alguno falta, mide menos de 32 caracteres,
# conserva un valor "cambia-esto-..." o se repite.
#
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Ningún secreto va en un frontend ni con prefijo VITE_: todo lo VITE_* termina
# dentro del JavaScript público que descarga el navegador.
#
# ==============================================================================
# Variables de seguridad y red (Fase 2 - H-04, H-10, H-27):
#
#   CORS_ORIGINS      orígenes permitidos separados por coma con protocolo (http:// o https://).
#                     Desarrollo: http://localhost:5173,http://localhost:5174,http://localhost:5175
#                     Producción: https://app.<DOMINIO>,https://staff.<DOMINIO>,https://cocina.<DOMINIO>
#                     Obligatorio en producción en backend/ y socket-server/.
#   TRUST_PROXY       confianza en proxy inverso (Nginx / Docker) para IPs reales en rate limit.
#                     Desarrollo: vacío (desactivado). Producción: 172.31.250.10 o 1.
# ==============================================================================

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
TRUST_PROXY=

