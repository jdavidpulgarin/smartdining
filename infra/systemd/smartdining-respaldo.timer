# SmartDining · respaldo diario a las 03:30 de Bogotá (R-18).
# Persistent: si el VPS estaba apagado a esa hora, corre al arrancar.
#   Próxima corrida: systemctl list-timers smartdining-respaldo.timer
[Unit]
Description=SmartDining: respaldo diario de la base a las 03:30 (R-18)

[Timer]
OnCalendar=*-*-* 03:30:00 America/Bogota
RandomizedDelaySec=5min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
