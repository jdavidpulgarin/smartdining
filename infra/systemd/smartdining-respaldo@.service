# SmartDining · respaldo diario de la base de UN entorno (R-18). Plantilla: %i
# es el entorno (staging o produccion); cada uno tiene su servicio y su timer.
# Lo instala infra/scripts/instalar-respaldos.sh; guía en docs/despliegue.md §4.
#
# Respalda el proyecto de ese entorno (smartdining-staging o smartdining) en
# /srv/respaldos/<proyecto>/diario/ y conserva 7.
#   A mano:   sudo systemctl start smartdining-respaldo@staging.service
#   Registro: journalctl -u smartdining-respaldo@staging
#
# healthchecks.io: si /etc/smartdining/respaldo-%i.env (600 root, NUNCA en el
# repo) define HEALTHCHECKS_URL, avisa al terminar bien y a <url>/fail si falla.
# Un check por entorno. Si el aviso no llega (sin red), el respaldo no se da
# por fallido. El entorno que está apagado tiene su timer desactivado (si no,
# fallaría cada noche: no hay postgres que respaldar).
[Unit]
Description=SmartDining: respaldo diario de la base (%i, R-18)
Documentation=https://github.com/jdavidpulgarin/smartdining/blob/develop/docs/despliegue.md
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
UMask=0027
Environment=ENTORNO=%i
EnvironmentFile=-/etc/smartdining/respaldo-%i.env
ExecStart=/bin/sh /usr/local/lib/smartdining/respaldo.sh diario
# $$ = un $ literal para el shell (systemd no expande ${VAR:-}).
ExecStartPost=-/bin/sh -c '[ -z "$${HEALTHCHECKS_URL:-}" ] || curl -fsS -m 10 --retry 3 -o /dev/null "$$HEALTHCHECKS_URL"'
ExecStopPost=-/bin/sh -c '[ "$$SERVICE_RESULT" = success ] || [ -z "$${HEALTHCHECKS_URL:-}" ] || curl -fsS -m 10 --retry 3 -o /dev/null "$$HEALTHCHECKS_URL/fail"'
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
