# ==============================================================================
# SmartDining — variables de PRODUCCIÓN para docker-compose.prod.yml
# En el VPS: cp infra/.env.example infra/.env && chmod 600 infra/.env
# infra/.env está en .gitignore (patrón .env). NUNCA lo subas al repositorio.
#
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (o: openssl rand -hex 32). Todos distintos entre sí.
# ==============================================================================

# DATO PENDIENTE: dominio del proyecto (sin https:// ni subdominio).
# Se publican app., staff., cocina., api. y rt. de este dominio.
DOMINIO=cambia-esto.example.com
# Correo para avisos de Let's Encrypt (vencimientos)
CERTBOT_EMAIL=cambia-esto@example.com

POSTGRES_DB=smartdining
POSTGRES_USER=smartdining
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga
REDIS_PASSWORD=cambia-esto-por-otra-clave-larga

# Compartidos por backend y socket-server (el compose los pasa a ambos)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
INTERNAL_API_KEY=cambia-esto-por-una-clave-interna-larga
# Solo socket-server
QR_SECRET=cambia-esto-por-otro-secreto-largo

# Web Push (npm run vapid en socket-server). Opcional.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cambia-esto@example.com

# Wompi. Todo o nada. DATO PENDIENTE: llaves sandbox del comercio.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_API_URL=

LOG_NIVEL=info
