# ==============================================================================
# SmartDining — variables de STAGING para docker-compose.prod.yml
# Guía: docs/despliegue.md, sección "6. Staging".
#
# En el VPS (dentro de /srv/smartdining-staging):
#   cp infra/.env.staging.example infra/.env.staging && chmod 600 infra/.env.staging
# infra/.env.staging está en .gitignore. NUNCA lo subas al repositorio.
#
# Cada secreto se genera EN EL VPS con: openssl rand -hex 32
# Todos distintos entre sí y distintos de los de producción.
# ==============================================================================

# Proyecto de compose: separa contenedores, redes y volúmenes (base, Redis,
# certificados) de los de producción ("smartdining"). No lo cambies: el
# workflow Deploy staging se niega a desplegar si no es exactamente este.
COMPOSE_PROJECT_NAME=smartdining-staging

# Se publican app., staff., cocina., api. y rt. de este dominio.
DOMINIO=staging.smartdining.com.co
# Correo para avisos de Let's Encrypt (vencimientos)
CERTBOT_EMAIL=cambia-esto@example.com

POSTGRES_DB=smartdining
POSTGRES_USER=smartdining
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga
REDIS_PASSWORD=cambia-esto-por-otra-clave-larga

# Compartidos por backend y socket-server (el compose los pasa a ambos)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
INTERNAL_API_KEY=cambia-esto-por-una-clave-interna-larga
# Solo socket-server
QR_SECRET=cambia-esto-por-otro-secreto-largo

# Web Push: un par propio de staging (npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cambia-esto@example.com

# Wompi SANDBOX (llaves pub_test_ / prv_test_ / test_integrity_ / test_events_).
# Todo o nada.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1

LOG_NIVEL=info
